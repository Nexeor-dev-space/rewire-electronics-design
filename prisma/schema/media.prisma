model MediaAsset {
  id       String @id @default(cuid())
  mimeType String
  data     Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       Category[]
  brands           Brand[]
  productImages    ProductImage[]
  productOgImages  Product[]
  homepageSections HomepageSection[]
  orderItems       OrderItem[]

  @@map("media_assets")
}
