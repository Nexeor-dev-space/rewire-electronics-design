model MediaAsset {
  id       String @id @default(cuid())
  mimeType String
  data     Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories             Category[]
  brands                 Brand[]
  productImages          ProductImage[]
  productOgImages        Product[]
  homepageSections       HomepageSection[]     @relation("HomepageSectionImage")
  homepageMobileSections HomepageSection[]     @relation("HomepageSectionMobileImage")
  homepageItems          HomepageSectionItem[]
  orderItems             OrderItem[]
  policyOgImages         Policy[]
  homepageOgImages       HomepageState[]
  campaignBanners        Campaign[]
  campaignImages         CampaignImage[]

  @@map("media_assets")
}
