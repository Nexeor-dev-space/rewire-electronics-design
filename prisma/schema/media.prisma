/// The bytes live in MinIO under `media/<id>`. `data` only holds images
/// uploaded before the move, until `npm run db:media-to-minio -- --clear`
/// empties it.
model MediaAsset {
  id       String @id @default(cuid())
  mimeType String
  data     Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories             Category[]
  brands                 Brand[]
  productImages          ProductImage[]
  productOgImages        Product[]
  homepageSections       HomepageSection[]     @relation("HomepageSectionImage")
  homepageMobileSections HomepageSection[]     @relation("HomepageSectionMobileImage")
  homepageItems          HomepageSectionItem[]
  orderItems             OrderItem[]
  policyOgImages         Policy[]
  homepageOgImages       HomepageState[]
  campaignBanners        Campaign[]
  campaignImages         CampaignImage[]

  @@map("media_assets")
}
