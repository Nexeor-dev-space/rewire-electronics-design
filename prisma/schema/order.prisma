model Order {
  id                      String             @id @default(cuid())
  number                  String             @unique
  idempotencyKey          String             @unique
  userId                  String?
  placedAsGuest           Boolean            @default(false)
  status                  OrderStatus
  paymentStatus           PaymentStatus      @default(UNPAID)
  paymentMethod           PaymentMethod
  deliveredAt             DateTime?
  returnableUntil         DateTime?
  trackingNumber          String             @default("")
  staffNote               String             @default("")
  email                   String
  phone                   String
  firstName               String
  lastName                String
  emailOptIn              Boolean            @default(false)
  address1                String
  address2                String             @default("")
  city                    String
  postalCode              String             @default("")
  emirate                 Emirate
  deliveryMethod          DeliveryMethod
  deliveryEtaMinDays      Int
  deliveryEtaMaxDays      Int
  subtotal                Int
  discount                Int                @default(0)
  deliveryFee             Int
  total                   Int
  vatIncluded             Int
  vatRatePercent          Int
  refundedAmount          Int                @default(0)
  couponCode              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deliveryAreaId          String?
  /// The order's current Stripe payment page (`cs_…`); a retry reuses it while open. See docs/PAYMENTS.md.
  stripeCheckoutSessionId String?            @unique
  /// Stripe PaymentIntent (`pi_…`) that paid the order; null for cash on delivery or unpaid. See docs/PAYMENTS.md.
  stripePaymentIntentId   String?            @unique
  couponRedemption        CouponRedemption?
  items                   OrderItem[]
  events                  OrderStatusEvent[]
  deliveryArea            DeliveryArea?      @relation(fields: [deliveryAreaId], references: [id])
  user                    User?              @relation(fields: [userId], references: [id])
  returns                 ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@index([deliveryAreaId])
  @@map("orders")
}

model OrderItem {
  id               String           @id @default(cuid())
  orderId          String
  variantId        String?
  imageId          String?
  productName      String
  productSlug      String
  brandName        String
  sku              String
  storage          String?
  colour           String?
  condition        ProductCondition
  grade            ProductGrade?
  warrantyMonths   Int
  imageAlt         String           @default("")
  unitPrice        Int
  addOnUnitPrice   Int              @default(0)
  quantity         Int
  lineTotal        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  warrantyEndsAt   DateTime?
  warrantyStartsAt DateTime?
  devices          devices[]
  addOns           OrderItemAddOn[]
  image            MediaAsset?      @relation(fields: [imageId], references: [id])
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant?  @relation(fields: [variantId], references: [id])
  returnItems      ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([imageId])
  @@map("order_items")
}

model OrderItemAddOn {
  id                  String    @id @default(cuid())
  orderItemId         String
  addOnId             String?
  name                String
  kind                AddOnKind
  price               Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  extraWarrantyMonths Int       @default(0)
  addOn               AddOn?    @relation(fields: [addOnId], references: [id])
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([addOnId])
  @@map("order_item_add_ons")
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String      @default("")
  actorId   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  actor     User?       @relation(fields: [actorId], references: [id])
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  discount  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  COD
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}
