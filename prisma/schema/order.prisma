enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  COD
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}

model Order {
  id             String  @id @default(cuid())
  number         String  @unique
  idempotencyKey String  @unique
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  placedAsGuest  Boolean @default(false)

  status          OrderStatus
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod
  deliveredAt     DateTime?
  returnableUntil DateTime?
  trackingNumber  String        @default("")
  staffNote       String        @default("")

  email      String
  phone      String
  firstName  String
  lastName   String
  emailOptIn Boolean @default(false)

  address1   String
  address2   String  @default("")
  city       String
  postalCode String  @default("")
  emirate    Emirate

  deliveryMethod     DeliveryMethod
  deliveryEtaMinDays Int
  deliveryEtaMaxDays Int

  subtotal       Int
  discount       Int     @default(0)
  deliveryFee    Int
  total          Int
  vatIncluded    Int
  vatRatePercent Int
  refundedAmount Int     @default(0)
  couponCode     String?

  items            OrderItem[]
  events           OrderStatusEvent[]
  couponRedemption CouponRedemption?
  returns          ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  imageId   String?
  image     MediaAsset?     @relation(fields: [imageId], references: [id], onDelete: SetNull)

  productName    String
  productSlug    String
  brandName      String
  sku            String
  storage        String?
  colour         String?
  condition      ProductCondition
  grade          ProductGrade?
  warrantyMonths Int
  imageAlt       String           @default("")

  unitPrice      Int
  addOnUnitPrice Int @default(0)
  quantity       Int
  lineTotal      Int

  addOns      OrderItemAddOn[]
  returnItems ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@index([imageId])
  @@map("order_items")
}

model OrderItemAddOn {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOnId     String?
  addOn       AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  name        String
  kind        AddOnKind
  price       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderItemId])
  @@index([addOnId])
  @@map("order_item_add_ons")
}

model OrderStatusEvent {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  note    String      @default("")
  actorId String?
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model CouponRedemption {
  id       String  @id @default(cuid())
  couponId String
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  discount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}
