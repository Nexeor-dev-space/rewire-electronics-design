model Policy {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  eyebrow         String        @default("Legal")
  lede            String
  draft           Boolean       @default(true)
  published       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  metaDescription String?
  ogImageId       String?
  seoTitle        String?
  ogImage         MediaAsset?   @relation(fields: [ogImageId], references: [id])
  blocks          PolicyBlock[]

  @@map("policies")
}

model PolicyBlock {
  id        String   @id @default(cuid())
  policyId  String
  anchor    String
  title     String
  content   Json
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, anchor])
  @@index([policyId, sortOrder])
  @@map("policy_blocks")
}
