enum ReleaseHoldStatus {
  HELD
  ORDERED
  RELEASED
}

enum ReleaseEmailKind {
  WELCOME
  REMINDER
  LIVE
}

enum ReleaseEmailStatus {
  SENDING
  SENT
  FAILED
}

model Release {
  id                     String    @id @default(cuid())
  slug                   String?   @unique
  title                  String
  edition                String    @default("")
  description            String    @default("")
  startsAt               DateTime
  endsAt                 DateTime?
  publishedAt            DateTime?
  hidden                 Boolean   @default(false)
  maxPerCustomer         Int       @default(1)
  reminderOffsetsMinutes Int[]     @default([])
  completedAt            DateTime?
  productId              String?
  product                Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  allocations ReleaseAllocation[]
  tallies     ReleaseCustomerTally[]
  waitlist    WaitlistEntry[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  campaigns   Campaign[]

  @@index([publishedAt, hidden, startsAt])
  @@index([completedAt, endsAt])
  @@index([active, startsAt])
  @@map("releases")
}

model ReleaseAllocation {
  id        String         @id @default(cuid())
  releaseId String
  release   Release        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  allocated Int            @default(0)
  available Int            @default(0)
  reserved  Int            @default(0)
  sold      Int            @default(0)
  returned  Int            @default(0)
  holds     ReleaseHold[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([releaseId, variantId])
  @@index([variantId])
  @@map("release_allocations")
}

model ReleaseHold {
  id           String            @id @default(cuid())
  allocationId String
  allocation   ReleaseAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  cartId       String?
  cart         Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quantity     Int
  status       ReleaseHoldStatus @default(HELD)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, expiresAt])
  @@index([cartId, status])
  @@index([allocationId])
  @@index([orderId])
  @@map("release_holds")
}

model ReleaseCustomerTally {
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([releaseId, userId])
  @@index([userId])
  @@map("release_customer_tallies")
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  releaseId     String
  release       Release        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  email         String
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailOptIn    Boolean        @default(true)
  whatsappOptIn Boolean        @default(false)
  phone         String?
  confirmedAt   DateTime?
  emails        ReleaseEmail[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([releaseId, email])
  @@index([email])
  @@index([userId])
  @@map("waitlist_entries")
}

model ReleaseEmail {
  id            String             @id @default(cuid())
  entryId       String
  entry         WaitlistEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind          ReleaseEmailKind
  offsetMinutes Int                @default(0)
  status        ReleaseEmailStatus @default(SENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([entryId, kind, offsetMinutes])
  @@map("release_emails")
}
