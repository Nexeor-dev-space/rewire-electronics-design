model Category {
  id              String                @id @default(cuid())
  name            String
  nameKey         String                @unique
  parentId        String?
  imageId         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  slug            String                @unique
  description     String                @default("")
  showInNav       Boolean               @default(true)
  sortOrder       Int                   @default(0)
  status          CategoryStatus        @default(PUBLISHED)
  metaDescription String?
  seoTitle        String?
  addOns          AddOnCategory[]
  image           MediaAsset?           @relation(fields: [imageId], references: [id])
  parent          Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]            @relation("CategoryTree")
  coupons         CouponCategory[]
  homepageItems   HomepageSectionItem[]
  products        Product[]

  @@index([parentId])
  @@index([status, sortOrder])
  @@index([updatedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("categories")
}

/// A manufacturer. Flat — brands have no hierarchy.
model Brand {
  id        String      @id @default(cuid())
  name      String
  /// See `Category.nameKey`.
  nameKey   String      @unique
  imageId   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  image     MediaAsset? @relation(fields: [imageId], references: [id])
  products  Product[]

  @@index([updatedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("brands")
}

model Product {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  description     String                @default("")
  brandId         String
  categoryId      String
  warrantyMonths  Int                   @default(12)
  highlights      String[]
  included        String[]
  status          ProductStatus         @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  minPrice        Int                   @default(0)
  /// Soft delete: set when the product goes to Trash, cleared on restore.
  /// Every product query filters `deletedAt: null`; see docs/TRASH-AUDIT.md.
  deletedAt       DateTime?
  /// A site path (`/product/x`) or an absolute https URL.
  canonicalUrl    String?
  metaDescription String?
  metaKeywords    String[]
  ogDescription   String?
  ogImageId       String?
  ogTitle         String?
  /// SEO overrides, all optional. Empty means the storefront falls back to
  /// the product's own name, description and images; see `productSeo` in
  /// `src/lib/seo.ts` and docs/CATALOGUE.md.
  seoTitle        String?
  coupons         CouponProduct[]
  homepageItems   HomepageSectionItem[]
  addOns          ProductAddOn[]
  images          ProductImage[]
  specs           ProductSpec[]
  variants        ProductVariant[]
  brand           Brand                 @relation(fields: [brandId], references: [id])
  category        Category              @relation(fields: [categoryId], references: [id])
  ogImage         MediaAsset?           @relation(fields: [ogImageId], references: [id])

  @@index([status, publishedAt])
  @@index([status, minPrice])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model ProductVariant {
  id             String           @id @default(cuid())
  productId      String
  sku            String           @unique
  storage        String?
  colour         String?
  colourHex      String?
  price          Int
  compareAtPrice Int?
  stock          Int              @default(0)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  condition      ProductCondition
  grade          ProductGrade?
  batteryHealth  Int?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([stock])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("product_variants")
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  mediaId   String
  alt       String     @default("")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  colour    String?
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  group     String
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_specs")
}

model AddOn {
  id                  String           @id @default(cuid())
  name                String
  note                String           @default("")
  kind                AddOnKind
  price               Int
  popular             Boolean          @default(false)
  active              Boolean          @default(true)
  appliesToAll        Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  extraWarrantyMonths Int              @default(0)
  categories          AddOnCategory[]
  cartItems           CartItemAddOn[]
  orderItemAddOns     OrderItemAddOn[]
  products            ProductAddOn[]

  @@index([active, appliesToAll])
  @@index([updatedAt])
  @@map("add_ons")
}

model AddOnCategory {
  addOnId    String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([addOnId, categoryId])
  @@index([categoryId])
  @@map("add_on_categories")
}

model ProductAddOn {
  productId     String
  addOnId       String
  priceOverride Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  addOn         AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, addOnId])
  @@index([addOnId])
  @@map("product_add_ons")
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductCondition {
  NEW
  OPEN_BOX
  PRE_OWNED
  REFURBISHED
}

enum ProductGrade {
  PREMIUM
  EXCELLENT
  VERY_GOOD
  GOOD
}

enum AddOnKind {
  PROTECTION
  ACCESSORY
  SERVICE
}
