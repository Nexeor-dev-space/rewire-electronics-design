model devices {
  id              String            @id
  orderItemId     String
  unitNumber      Int
  serialNumber    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  order_items     OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warranty_claims warranty_claims[]

  @@unique([orderItemId, unitNumber])
}

model warranty_claim_events {
  id              String              @id
  claimId         String
  status          WarrantyClaimStatus
  note            String              @default("")
  actorId         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime
  users           User?               @relation(fields: [actorId], references: [id])
  warranty_claims warranty_claims     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
}

model warranty_claims {
  id                    String                  @id
  number                String                  @unique
  serialNumber          String
  status                WarrantyClaimStatus     @default(RAISED)
  issue                 String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deviceId              String
  warranty_claim_events warranty_claim_events[]
  devices               devices                 @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@index([status, createdAt])
}

enum WarrantyClaimStatus {
  RAISED
  SERIAL_VERIFICATION
  COLLECTION
  ASSESSMENT
  REPAIR
  REPLACEMENT
  RETURNED_TO_CUSTOMER
  DECLINED
}
