enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Who wrote a message: the customer, or a staff member answering them.
enum TicketSender {
  CUSTOMER
  STAFF
}

enum TicketEventType {
  CREATED
  STATUS
  PRIORITY
  ASSIGNMENT
}

/// A category an Admin manages from the Support Tickets screen. Deactivated,
/// never deleted, so old tickets keep their category.
model TicketCategory {
  id        String  @id @default(cuid())
  name      String
  /// Trimmed and lowercased name, so names are unique ignoring case.
  nameKey   String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  tickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("ticket_categories")
}

/// One customer conversation, from the first message to closure.
model SupportTicket {
  id       String         @id @default(cuid())
  number   String         @unique
  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The customer account, when the email belongs to one. The name and email
  /// below are kept either way, so staff can always write back.
  customerId    String?
  customer      User?   @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Drive the "needs a reply" highlight and the list sort without scanning messages.
  lastCustomerMessageAt DateTime?
  lastStaffReplyAt      DateTime?

  messages TicketMessage[]
  events   TicketEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([categoryId])
  @@index([orderId])
  @@index([updatedAt])
  @@map("support_tickets")
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender   TicketSender
  /// The staff member who wrote it. Null for customer messages.
  authorId String?
  author   User?         @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// The ticket's history: creation, status, priority and assignment changes.
/// From and to hold readable text (a label or a staff name) as it was then.
model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketEventType
  fromValue String          @default("")
  toValue   String          @default("")
  actorId   String?
  actor     User?           @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}
