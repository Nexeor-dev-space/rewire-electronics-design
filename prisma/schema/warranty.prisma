/// A claim's stage. Mirrored by WARRANTY_CLAIM_STATUSES in src/lib/warranty.ts.
enum WarrantyClaimStatus {
  RAISED
  SERIAL_VERIFICATION
  COLLECTION
  ASSESSMENT
  REPAIR
  REPLACEMENT
  RETURNED_TO_CUSTOMER
  DECLINED
}

/// One physical unit sold: a line with quantity 3 has devices 1, 2 and 3, each
/// with its own serial or IMEI. Created with the order line at checkout. The
/// warranty dates stay on the line, since its units are delivered together.
/// See docs/WARRANTY.md.
model Device {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// 1 up to the line's quantity.
  unitNumber   Int
  serialNumber String?

  warrantyClaims WarrantyClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderItemId, unitNumber])
  @@map("devices")
}

/// A warranty claim against one device.
model WarrantyClaim {
  id           String              @id @default(cuid())
  number       String              @unique
  deviceId     String
  device       Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// The device's serial when the claim was raised, kept if the serial is corrected later.
  serialNumber String
  status       WarrantyClaimStatus @default(RAISED)
  issue        String

  events WarrantyClaimEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, status])
  @@index([status, createdAt])
  @@map("warranty_claims")
}

model WarrantyClaimEvent {
  id      String              @id @default(cuid())
  claimId String
  claim   WarrantyClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  status  WarrantyClaimStatus
  note    String              @default("")
  actorId String?
  actor   User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimId, createdAt])
  @@map("warranty_claim_events")
}
