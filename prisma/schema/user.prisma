/// Who an account is. ADMIN and STAFF reach the console; CUSTOMER never does.
/// Which console areas each role reaches is configured in
/// `src/lib/auth/permissions.ts`, not here.
enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

/// Soft delete. An INACTIVE user is treated as deleted: hidden from lists,
/// unable to sign in, and any cookie it still holds stops working. Its email
/// stays reserved.
enum UserState {
  ACTIVE
  INACTIVE
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  /// Stored lowercased and trimmed, so uniqueness is case-insensitive.
  email        String    @unique
  phone        String
  role         UserRole  @default(CUSTOMER)
  state        UserState @default(ACTIVE)
  /// scrypt hash — see `src/lib/auth/password.ts`. Null until a password is
  /// set, which means the account cannot sign in.
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses Address[]

  @@index([state, updatedAt])
  @@map("users")
}

enum Emirate {
  ABU_DHABI
  AJMAN
  DUBAI
  FUJAIRAH
  RAS_AL_KHAIMAH
  SHARJAH
  UMM_AL_QUWAIN
}

/// A saved delivery address. Exactly one per user has `isPrimary` set when
/// they have any — enforced in `src/services/customer.service.ts`.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emirate   Emirate
  street    String
  landmark  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("addresses")
}
