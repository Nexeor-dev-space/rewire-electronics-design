/// Who an account is. ADMIN and STAFF reach the console; CUSTOMER never does.
/// ADMIN and CUSTOMER access is fixed in `src/lib/auth/permissions.ts`; what a
/// STAFF account may do comes from its `StaffRole`.
enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

/// Soft delete. An INACTIVE user is treated as deleted: hidden from lists,
/// unable to sign in, and any cookie it still holds stops working. Its email
/// stays reserved.
enum UserState {
  ACTIVE
  INACTIVE
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  /// Stored lowercased and trimmed, so uniqueness is case-insensitive.
  email           String    @unique
  phone           String?
  role            UserRole  @default(CUSTOMER)
  state           UserState @default(ACTIVE)
  /// scrypt hash — see `src/lib/auth/password.ts`. Null until a password is
  /// set, which means the account cannot sign in.
  passwordHash    String?
  emailVerifiedAt DateTime?
  sessionVersion  Int       @default(0)
  /// STAFF only. Null means no access until an Admin assigns a role.
  staffRoleId     String?
  staffRole       StaffRole? @relation("StaffRoleUsers", fields: [staffRoleId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  authTokens    AuthToken[]
  oauthAccounts OAuthAccount[]
  cart          Cart?

  integrationSettingsUpdates   IntegrationSettings[]
  integrationCredentialUpdates IntegrationCredential[]
  staffRoleUpdates             StaffRole[]           @relation("StaffRoleUpdatedBy")
  auditLogs                    AuditLog[]

  @@index([state, updatedAt])
  @@index([staffRoleId])
  @@map("users")
}

/// A role's access to one admin module. No row means No Access. What each
/// level allows is decided in `levelActions` (`src/lib/auth/permissions.ts`).
enum AccessLevel {
  VIEW
  EDIT
  FULL
}

/// A custom role an Admin creates and assigns to STAFF accounts. It can't be
/// deleted while any account holds it.
model StaffRole {
  id          String                @id @default(cuid())
  name        String
  /// Trimmed and lowercased name, so names are unique ignoring case.
  nameKey     String                @unique
  description String?
  users       User[]                @relation("StaffRoleUsers")
  permissions StaffRolePermission[]
  updatedById String?
  updatedBy   User?                 @relation("StaffRoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("staff_roles")
}

model StaffRolePermission {
  roleId String
  role   StaffRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// A permission module key, e.g. `catalogue.products`.
  module String
  level  AccessLevel

  @@id([roleId, module])
  @@map("staff_role_permissions")
}

enum AuthTokenType {
  VERIFY
  RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, type])
  @@map("auth_tokens")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum Emirate {
  ABU_DHABI
  AJMAN
  DUBAI
  FUJAIRAH
  RAS_AL_KHAIMAH
  SHARJAH
  UMM_AL_QUWAIN
}

/// A saved delivery address. Exactly one per user has `isPrimary` set when
/// they have any — enforced in `src/services/customer.service.ts`.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emirate   Emirate
  street    String
  landmark  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("addresses")
}
