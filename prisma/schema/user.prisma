/// Who an account is. ADMIN and STAFF reach the console; CUSTOMER never does.
/// Which console modules STAFF reaches, and what it may do there, is stored in
/// `RolePermission`; ADMIN and CUSTOMER are fixed in `src/lib/auth/permissions.ts`.
enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

/// Soft delete. An INACTIVE user is treated as deleted: hidden from lists,
/// unable to sign in, and any cookie it still holds stops working. Its email
/// stays reserved.
enum UserState {
  ACTIVE
  INACTIVE
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  /// Stored lowercased and trimmed, so uniqueness is case-insensitive.
  email           String    @unique
  phone           String?
  role            UserRole  @default(CUSTOMER)
  state           UserState @default(ACTIVE)
  /// scrypt hash — see `src/lib/auth/password.ts`. Null until a password is
  /// set, which means the account cannot sign in.
  passwordHash    String?
  emailVerifiedAt DateTime?
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  authTokens    AuthToken[]
  oauthAccounts OAuthAccount[]
  cart          Cart?

  integrationSettingsUpdates   IntegrationSettings[]
  integrationCredentialUpdates IntegrationCredential[]
  rolePermissionUpdates        RolePermission[]
  auditLogs                    AuditLog[]

  @@index([state, updatedAt])
  @@map("users")
}

/// What a role may do inside one admin module.
enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  PUBLISH
  RESTORE
}

model RolePermission {
  role        UserRole
  module      String
  actions     PermissionAction[]
  updatedById String?
  updatedBy   User?              @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([role, module])
  @@map("role_permissions")
}

enum AuthTokenType {
  VERIFY
  RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, type])
  @@map("auth_tokens")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum Emirate {
  ABU_DHABI
  AJMAN
  DUBAI
  FUJAIRAH
  RAS_AL_KHAIMAH
  SHARJAH
  UMM_AL_QUWAIN
}

/// A saved delivery address. Exactly one per user has `isPrimary` set when
/// they have any — enforced in `src/services/customer.service.ts`.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emirate   Emirate
  street    String
  landmark  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("addresses")
}
